# Python caches / local environments
__pycache__/
*.py[cod]
!*.pyd
.venv/
venv/
env/
.env
.env.*
!.env.example

# Generated builds (tracked .pyd / python311.dll are required runtime assets)
build/
dist/
*.egg-info/
.eggs/
cython_debug/

# Local-only regression tests and offline tools
/tests/
/tools/

# Test, lint and coverage outputs
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Runtime captures, reports and logs
/data/*
!/data/picture/
/data/picture/*
!/data/picture/junhe.ico
/outputs/
*.log

# Editor / local analysis state
.idea/
.vscode/
.VSCodeCounter/
.scannerwork/
sonar-project.properties
Thumbs.db
.DS_Store
